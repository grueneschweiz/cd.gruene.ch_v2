{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "on Wednesday"
  ],
  "updateNotScheduled": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Automerge all patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep php and selected webpack packages out of grouped updates",
      "matchPackageNames": [
        "php",
        "webpack",
        "webpack-cli",
        "laravel-mix/webpackbar"
      ],
      "groupName": null
    },
    {
      "description": "Bundle all minor updates into one PR",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "all minor dependencies",
      "groupSlug": "all-minor-dependencies",
      "matchPackageNames": [
        "!php",
        "!webpack",
        "!webpack-cli",
        "!laravel-mix/webpackbar"
      ]
    },
    {
      "description": "Keep major updates as individual PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
