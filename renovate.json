{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Automerge all patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Bundle all minor updates into one PR",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "all minor dependencies",
      "groupSlug": "all-minor-dependencies"
    },
    {
      "description": "Keep major updates as individual PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
